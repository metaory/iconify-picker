---
import Section from '../ui/Section.astro';
import ApiSection from '../ui/ApiSection.astro';

const methods = [
  { name: 'show()', description: 'Shows the icon picker dialog.' },
  { name: 'hide()', description: 'Hides the icon picker dialog.' },
  { name: 'toggle()', description: 'Toggles the icon picker dialog open/close state.' },
  { name: 'reset()', description: 'Resets the picker: clears selection and search term, reloads icons.' },
  { name: 'focus()', description: 'Focuses the picker (search input or toggle button).' }
];

const attributes = [
  { name: 'collection', default: '""', description: 'Icon collection to display (e.g., "mdi", "fa", "heroicons")' },
  { name: 'page-size', default: '"60"', description: 'Number of icons per page' },
  { name: 'height', default: '""', description: 'Height of the picker container' },
  { name: 'theme', default: '"auto"', description: 'Theme mode: "auto", "light", or "dark"' },
  { name: 'search', default: '""', description: 'Initial search term' },
  { name: 'selected', default: '""', description: 'Initially selected icon in "collection:name" format' },
  { name: 'mode', default: '"inline"', description: 'Picker display mode: "inline", "button", or "manual"' },
  { name: 'button-label', default: '"Choose Icon"', description: 'Label text for button mode' },
  { name: 'filter', default: '""', description: 'Filter icons by name pattern' },
  { name: 'hidden', default: 'false', description: 'Hides the picker when set (for manual mode)' }
];
---

<Section id="api" title="API Reference">
  <ApiSection id="methods" title="Methods">
    <table>
      <thead>
        <tr>
          <th>Method</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {methods.map(method => (
          <tr>
            <td><code>{method.name}</code></td>
            <td>{method.description}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </ApiSection>

  <ApiSection id="attributes" title="Attributes">
    <table>
      <thead>
        <tr>
          <th>Attribute</th>
          <th>Default</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {attributes.map(attr => (
          <tr>
            <td><code>{attr.name}</code></td>
            <td><code>{attr.default}</code></td>
            <td>{attr.description}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </ApiSection>
</Section> 