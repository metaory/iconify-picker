---
import { Code } from 'astro:components';
import Section from '../ui/Section.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import Card from '../ui/Card.astro';
import EventLog from '../ui/EventLog.astro';

const eventListenerCode = `
// Add event listener
document.querySelector('iconify-picker')
  .addEventListener('iconify-select', (e) => {
    console.log('Selected icon:', e.detail.name);
  });
`;

const eventsTable = [
  { name: 'iconify-select', detail: '{ name: string, collection: string }', description: 'Fired when an icon is selected' },
  { name: 'iconify-dialog-open', detail: 'none', description: 'Fired when the picker dialog opens' },
  { name: 'iconify-dialog-close', detail: 'none', description: 'Fired when the picker dialog closes' }
];

const demoConfig = {
  title: 'Event Handling Demo',
  variant: 'example',
  pickerId: 'event-demo-picker',
  pickerMode: 'button',
  eventTargetId: 'event-target',
  eventLogId: 'event-log',
  placeholder: 'Select an icon to see events'
};
---

<Section id="events" title="Events">
  <p>
    The component fires events that you can listen for to react to user interactions:
  </p>

  <table>
    <thead>
      <tr>
        <th>Event Name</th>
        <th>Event Detail</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {eventsTable.map(event => (
        <tr>
          <td><code>{event.name}</code></td>
          <td><code>{event.detail}</code></td>
          <td>{event.description}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h3>Example</h3>
  <CodeBlock code={eventListenerCode} lang="js" />
  
  <Card title={demoConfig.title} variant={demoConfig.variant}>
    <div class="event-demo">
      <div id={demoConfig.eventTargetId} class="icon-container">
        <p class="placeholder">{demoConfig.placeholder}</p>
      </div>
      <iconify-picker id={demoConfig.pickerId} mode={demoConfig.pickerMode}></iconify-picker>
      <div id={demoConfig.eventLogId} class="event-log">
        <div class="event-log-header">Event Log</div>
        <div class="event-log-content"></div>
      </div>
    </div>
  </Card>
</Section>

<script define:vars={{ demoConfig }}>
  document.addEventListener('DOMContentLoaded', () => {
    const picker = document.getElementById(demoConfig.pickerId);
    const iconContainer = document.getElementById(demoConfig.eventTargetId);
    const eventLog = document.querySelector('.event-log-content');
    
    if (!picker || !iconContainer || !eventLog) return;
    
    const logEvent = (name, detail = {}) => {
      const entry = document.createElement('div');
      entry.className = 'event-entry';
      entry.innerHTML = `
        <div class="event-name">${name}</div>
        <div class="event-detail">${JSON.stringify(detail)}</div>
        <div class="event-time">${new Date().toLocaleTimeString()}</div>
      `;
      eventLog.prepend(entry);
      
      // Limit to 5 entries
      if (eventLog.children.length > 5) {
        eventLog.removeChild(eventLog.lastChild);
      }
    };
    
    picker.addEventListener('iconify-select', (e) => {
      const icon = e.detail.name;
      const collection = e.detail.collection;
      
      iconContainer.innerHTML = `<iconify-icon icon="${collection}:${icon}"></iconify-icon>`;
      logEvent('iconify-select', e.detail);
    });
    
    picker.addEventListener('iconify-dialog-open', () => {
      logEvent('iconify-dialog-open');
    });
    
    picker.addEventListener('iconify-dialog-close', () => {
      logEvent('iconify-dialog-close');
    });
  });
</script>

<style>
.event-demo {
  display: flex;
  flex-direction: column;
  gap: var(--s0);
}

.icon-container {
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed var(--bdr);
  border-radius: var(--r0);
  background: var(--bg1);
}

.placeholder {
  color: var(--tx1);
  font-style: italic;
}

.event-log {
  border: 1px solid var(--bdr);
  border-radius: var(--r0);
  overflow: hidden;
}

.event-log-header {
  background-color: var(--pri);
  color: white;
  padding: var(--s1) var(--s0);
  font-weight: bold;
}

.event-log-content {
  max-height: 200px;
  overflow-y: auto;
}

.event-entry {
  padding: var(--s1) var(--s0);
  border-bottom: 1px solid var(--bdr);
  font-family: monospace;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: var(--s2);
  align-items: center;
}

.event-name {
  font-weight: bold;
  color: var(--pri);
}

.event-time {
  color: var(--tx1);
  font-size: 0.8em;
}
</style> 