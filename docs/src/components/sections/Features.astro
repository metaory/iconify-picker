---
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';

const features = [
  {
    title: "Zero Dependencies",
    description: "No external libraries or frameworks required"
  },
  {
    title: "Autonomous Web Component",
    description: "Works with any framework or vanilla HTML"
  },
  {
    title: "Modern & Lightweight",
    description: "Built with modern web standards and minimal footprint"
  },
  {
    title: "Customizable",
    description: "Easy to style with CSS custom properties"
  }
];
---

<Section id="features" title="Features">
  <ul class="feature-list">
    {features.map(feature => (
      <li>
        <Card title={feature.title} variant="feature">
          <span>{feature.description}</span>
        </Card>
      </li>
    ))}
  </ul>
</Section>

<style>
.feature-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: var(--s0);
  list-style: none;
  padding: 0;
  margin-top: var(--s3);
}
</style> 