---
import Section from '../ui/Section.astro'
import CodeBlock from '../ui/CodeBlock.astro'

const installMethods = [
  {
    title: 'NPM Package',
    steps: [
      {
        description: 'Install the package using npm:',
        code: 'npm install iconify-picker',
        language: 'bash'
      },
      {
        description: 'Import it in your JavaScript:',
        code: "import IconifyPicker from 'iconify-picker';",
        language: 'javascript'
      },
      {
        description: 'Or use it directly in HTML with a script tag:',
        code: '<script type="module" src="./node_modules/iconify-picker/lib/iconify-picker.js"></script>',
        language: 'html'
      }
    ]
  },
  {
    title: 'CDN',
    steps: [
      {
        description: 'Alternatively, you can load the component directly from a CDN:',
        code: '<script type="module" src="https://cdn.jsdelivr.net/npm/iconify-picker/lib/iconify-picker.js"></script>',
        language: 'html'
      }
    ]
  }
];
---

<Section id="installation" title="Installation">
  <p>Install Iconify Picker using npm (recommended) or via CDN:</p>
  
  {installMethods.map((method, index) => (
    <div class="install-method">
      <h3>{index + 1}. {method.title}</h3>
      {method.steps.map(step => (
        <>
          <p>{step.description}</p>
          <CodeBlock code={step.code} lang={step.language} />
        </>
      ))}
    </div>
  ))}
</Section>

<style>
.install-method {
  margin-bottom: var(--s3);
}

.install-method h3 {
  margin-top: 0;
  margin-bottom: var(--s2);
}
</style> 