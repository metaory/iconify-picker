---
import Section from '../ui/Section.astro';
---

<Section id="introduction" title="Iconify Picker">
  <p class="lead">
    An autonomous web component for selecting icons from the Iconify project.
  </p>
  <p>
    Iconify Picker is a lightweight, dependency-free web component that allows you to easily
    integrate icon selection functionality into your web applications.
  </p>
</Section>

<style>
.lead {
  font-size: 1.25rem;
  color: var(--tx1);
  margin-bottom: var(--s3);
  border-left: 3px solid var(--acc);
  padding-left: var(--s0);
  font-style: italic;
}
</style> 