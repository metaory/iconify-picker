---
import Section from '../ui/Section.astro';
import Tabs from '../ui/Tabs.astro';
import PickerDemo from '../ui/PickerDemo.astro';
import EventLog from '../ui/EventLog.astro';
import CodeBlock from '../ui/CodeBlock.astro';

const tabs: Array<{ id: string; text: string; active?: boolean }> = [
  { id: 'inline-picker', text: 'Inline Mode', active: true },
  { id: 'button-picker', text: 'Button Mode' },
  { id: 'manual-picker', text: 'Manual Mode' }
];

const demoModes: Array<{ id: string; mode: 'inline' | 'button' | 'manual' }> = [
  { id: 'inline-mode-picker', mode: 'inline' },
  { id: 'button-mode-picker', mode: 'button' },
  { id: 'manual-mode-picker', mode: 'manual' }
];
---

<Section id="demo" title="Demo">
  <p>
    Iconify Picker can be used in different modes. Here are some demonstrations:
  </p>
  
  <Tabs tabs={tabs}>
    {demoModes.map((demo, index) => (
      <div id={tabs[index].id} class="showcase-section" data-content="tab-content">
        <PickerDemo mode={demo.mode} id={demo.id} />
        {demo.mode === 'manual' && (
          <CodeBlock 
            lang="html" 
            code={`<button id="open-picker">Open Picker</button>
<iconify-picker id="my-picker" mode="manual" hidden></iconify-picker>

<script>
  const picker = document.getElementById('my-picker');
  const button = document.getElementById('open-picker');
  
  button.addEventListener('click', () => {
    picker.toggle();
  });
</script>`} 
          />
        )}
      </div>
    ))}
    <EventLog id="icon-events-log" pickerIds={demoModes.map(d => d.id)} />
  </Tabs>
</Section>

<style>
.showcase-section {
  display: none;
}

.showcase-section.active {
  display: block;
}
</style> 