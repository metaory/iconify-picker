---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div id={id} class="api-section">
  <h3>{title}</h3>
  <slot />
</div>

<style>
.api-section {
  margin-bottom: var(--s3);
  border-radius: var(--r0);
  overflow: hidden;
}

.api-section h3 {
  margin-top: 0;
  padding-bottom: var(--s1);
  border-bottom: 1px solid var(--bdr);
}
</style> 