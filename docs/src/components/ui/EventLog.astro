---
interface Props {
  id: string;
  pickerIds?: string[];
}

const { id, pickerIds } = Astro.props;
---

<div id={id} class="event-log">
  <div class="log-header">
    <h4>Event Log</h4>
    <button class="clear-log transparent">Clear</button>
  </div>
  <div class="log-content"></div>
</div>

<style>
.event-log {
  display: grid;
  grid-template-rows: auto 1fr;
  margin-top: var(--s0);
  border: 1px solid var(--bdr);
  border-radius: var(--r0);
  overflow: hidden;
  background: var(--bg1);
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--s1) var(--s0);
  background: var(--pri);
  color: var(--wht);
}

.log-header h4 {
  margin: 0;
  font-size: 0.9rem;
}

.log-content {
  padding: var(--s2) var(--s0);
  max-height: 200px;
  overflow-y: auto;
  display: grid;
  gap: var(--s1);
  align-content: start;
}

.log-entry {
  margin: 0;
}

.log-entry :global(pre) {
  margin: 0;
  padding: var(--s1);
  border-radius: var(--r1);
  border: 1px solid var(--bdr);
  background: var(--bg0);
  font-size: 0.85rem;
  overflow-x: auto;
}

.log-entry :global(pre code) {
  font-family: 'Fira Code', 'Consolas', 'Monaco', 'Courier New', monospace;
  display: block;
}
</style>

<script define:vars={{ pickerIds }}>
document.addEventListener('DOMContentLoaded', () => {
  const logContainers = document.querySelectorAll('.event-log');
  
  logContainers.forEach(container => {
    const logContent = container.querySelector('.log-content');
    const clearBtn = container.querySelector('.clear-log');
    
    if (!logContent) return;
    
    const logEvent = (event) => {
      const entry = document.createElement('div');
      entry.className = 'log-entry';
      const detail = { ...event.detail };
      delete detail.svg;
      const eventData = {
        type: event.type,
        ...detail
      };
      const formattedJson = JSON.stringify(eventData, null, 2);
      const code = document.createElement('code');
      code.textContent = formattedJson;
      const pre = document.createElement('pre');
      pre.appendChild(code);
      entry.appendChild(pre);
      logContent.appendChild(entry);
      logContent.scrollTop = logContent.scrollHeight;
    };
    
    // If pickerIds are provided, listen to all of them
    if (pickerIds && pickerIds.length > 0) {
      pickerIds.forEach(pickerId => {
        const picker = document.getElementById(pickerId);
        if (picker) {
          picker.addEventListener('icon-selected', logEvent);
          picker.addEventListener('change', logEvent);
        }
      });
    } else {
      // Fallback to original behavior: try to find picker by removing '-log' from id
      const id = container.id.replace('-log', '');
      const picker = document.getElementById(id);
      if (picker) {
        picker.addEventListener('icon-selected', logEvent);
        picker.addEventListener('change', logEvent);
      }
    }
    
    // Clear log
    clearBtn?.addEventListener('click', () => {
      logContent.innerHTML = '';
    });
  });
});
</script> 