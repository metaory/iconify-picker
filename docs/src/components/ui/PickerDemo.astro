---
interface Props {
  mode: 'inline' | 'button' | 'manual';
  id?: string;
  collection?: string;
}
const {
  mode,
  id = `${mode}-mode-picker`,
  collection = 'mdi'
} = Astro.props;
---

<div class="picker-container">
  {mode === 'manual' &&
    <button id={`${id}-trigger`} class="manual-trigger">Open Picker</button>
  }
  <iconify-picker
    id={id}
    mode={mode === 'inline' ? undefined : mode}
    collection={collection}
    theme="auto"
    page-size="30"
    button-label={mode === 'button' ? 'Select Icon' : undefined}
    hidden={mode === 'manual' || mode === 'button' ? true : undefined}>
  </iconify-picker>
</div>

<style>
.picker-container {
  width: var(--w0);
  min-height: 300px;
  border: 1px solid var(--bdr);
  border-radius: var(--r0);
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg0);
  padding: var(--s0);
  gap: var(--s0);
  flex-direction: column;
}

.manual-trigger {
  background-color: var(--pri);
  color: var(--wht);
  padding: var(--s2) var(--s3);
  border: none;
  border-radius: 10px;
  cursor: pointer;
}
</style>

{mode === 'manual' &&
  <script define:vars={{ id }}>
    document.addEventListener('DOMContentLoaded', () => {
      const picker = document.getElementById(id);
      const trigger = document.getElementById(`${id}-trigger`);

      trigger?.addEventListener('click', () => {
        picker?.toggle();
      });
    });
  </script>
}
