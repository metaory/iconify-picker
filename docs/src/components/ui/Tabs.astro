---
interface Tab {
  id: string;
  text: string;
  active?: boolean;
}

interface Props {
  tabs: Tab[];
  contentId?: string;
}

const { tabs, contentId = 'tab-content' } = Astro.props;
---

<div class="tabs-container">
  <div class="tab-nav">
    {tabs.map(tab => (
      <button data-tab={tab.id} class={tab.active ? 'active' : ''}>
        {tab.text}
      </button>
    ))}
  </div>
  <div id={contentId} class="tab-content">
    <slot />
  </div>
</div>

<style>
.tabs-container {
  margin: var(--s0) 0;
}

.tab-nav {
  display: flex;
  gap: var(--s2);
  flex-wrap: var(--f-dir, nowrap);
}

.tab-nav button {
  background-color: var(--bg1);
  color: var(--tx0);
  border: 1px solid var(--bdr);
  border-radius: var(--r0) var(--r0) 0 0;
  padding: var(--s1) var(--s0);
}

.tab-nav button:hover {
  border-color: var(--pri);
}

.tab-nav button.active {
  background-color: var(--pri);
  color: var(--wht);
  border-color: var(--pri);
}

.tab-content {
  border: 1px solid var(--bdr);
  border-radius: 0 var(--r0) var(--r0) var(--r0);
  padding: var(--s3);
  background: var(--bg1);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const activateTab = (container, tabId) => {
    const tabs = container.querySelectorAll('.tab-nav button');
    const contentId = container.querySelector('.tab-content')?.id;
    if (!contentId) return;
    
    const targetTab = Array.from(tabs as NodeListOf<HTMLElement>).find(t => t.getAttribute('data-tab') === tabId);
    const sections = container.querySelectorAll(`[data-content="${contentId}"]`);
    const targetSection = Array.from(sections as NodeListOf<HTMLElement>).find(s => s.id === tabId);
    if (!targetTab || !targetSection) return;
    
    tabs.forEach(t => t.classList.remove('active'));
    sections.forEach(s => s.classList.remove('active'));
    
    targetTab.classList.add('active');
    targetSection.classList.add('active');
  };
  
  const initTabs = (container) => {
    const tabs = container.querySelectorAll('.tab-nav button');
    const contentId = container.querySelector('.tab-content')?.id;
    if (!contentId) return;
    
    const sections = container.querySelectorAll(`[data-content="${contentId}"]`);
    sections.forEach(s => s.classList.remove('active'));
    
    const firstTab = tabs[0];
    if (firstTab && sections.length) {
      const firstTabId = firstTab.getAttribute('data-tab');
      const firstSection = firstTabId ? Array.from(sections as NodeListOf<HTMLElement>).find(s => s.id === firstTabId) : null;
      if (firstSection) {
        firstSection.classList.add('active');
        firstTab.classList.add('active');
      }
    }
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const tabId = tab.getAttribute('data-tab');
        if (!tabId) return;
        activateTab(container, tabId);
      });
    });
  };
  
  document.querySelectorAll('.tabs-container').forEach(initTabs);
});
</script> 