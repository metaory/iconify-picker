---
import '@styles/global.css'
import Header from '@components/layout/Header.astro'
import Sidebar from '@components/layout/Sidebar.astro'
import Footer from '@components/layout/Footer.astro'
import { Font } from 'astro:assets'

const {
	title = 'Iconify Picker',
	description = 'An autonomous web component for the Iconify project'
} = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + '/favicon.png'} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<script type="module" src={import.meta.env.BASE_URL + '/iconify-picker.js'}></script>
		<Font cssVariable="--font-barcode" preload />
		<Font cssVariable="--font-bungee" preload />
		<Font cssVariable="--font-nabla" preload />
		<Font cssVariable="--font-monofett" preload />
		<Font cssVariable="--font-krypton" preload />
		<!-- <Font cssVariable="--font-staatliches" preload /> -->
		<Font cssVariable="--font-baloo2" preload />
		<Font cssVariable="--font-blackout-midnight" preload />
	</head>
	<body>
		<Header />
		<Sidebar />
		<main>
			<slot />
			<Footer />
		</main>
	</body>
</html>

<style>
	/* Layout grid structure */
	body {
		display: grid;
		width: var(--w0);
		max-width: 100vw;
		overflow-x: hidden;
		grid-template-columns: var(--g-body);
	}

	/* Main Content */
	main {
		backdrop-filter: blur(20px);
		padding: var(--s3);
		grid-column: var(--g-main);
		width: var(--w0);
		overflow-x: hidden;
		padding-top: var(--h1);
	}
</style>
